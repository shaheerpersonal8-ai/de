# ================================
# PROOFLY ENVIRONMENT CONFIGURATION
# ================================

# ================== SERVER CONFIG ==================
# Express server port
PORT=3000

# Node environment (development, staging, production)
NODE_ENV=development

# Server name/identifier
SERVER_NAME=proofly-server

# ================== SOLANA CONFIG ==================
# Solana RPC endpoint (devnet, testnet, mainnet)
SOLANA_RPC_URL=https://api.devnet.solana.com

# Solana network name
SOLANA_NETWORK=devnet

# Proofly program ID on Solana
PROOFLY_PROGRAM_ID=G9Fc28faoqwHW6BMCskBPbzLTF3Cu7j4SZAbVJxgwgAG

# Commitment level for Solana transactions (confirmed, finalized)
SOLANA_COMMITMENT=confirmed

# ================== EVALUATOR CONFIG ==================
# Evaluator keypair (JSON format of secret key byte array)
# IMPORTANT: Store securely in production, never commit to git
PROOFLY_EVALUATOR_KEYPAIR=

# Path to evaluator keypair file (fallback if env var not set)
EVALUATOR_KEYPAIR_PATH=~/.config/solana/evaluator.json

# AI model version
EVALUATOR_MODEL_VERSION=gpt-4-turbo

# Evaluator service version
EVALUATOR_VERSION=1.0.0

# AI evaluation timeout in milliseconds
AI_EVALUATION_TIMEOUT_MS=30000

# Maximum retry attempts for AI evaluation failures
AI_MAX_RETRIES=3

# Retry delay in milliseconds (with exponential backoff)
AI_RETRY_DELAY_MS=1000

# ================== OPENAI CONFIG ==================
# OpenAI API key for AI evaluations
# IMPORTANT: Store securely, never commit to git
OPENAI_API_KEY=

# OpenAI model name
OPENAI_MODEL=gpt-4-turbo

# OpenAI temperature (0.0 to 1.0, lower = more deterministic)
OPENAI_TEMPERATURE=0.3

# Max tokens for OpenAI responses
OPENAI_MAX_TOKENS=2000

# OpenAI API timeout in milliseconds
OPENAI_TIMEOUT_MS=30000

# ================== DATABASE CONFIG ==================
# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/proofly

# MongoDB database name
MONGODB_DATABASE=proofly

# ================== AUTHENTICATION ==================
# JWT secret key for token signing
# IMPORTANT: Use a strong random string in production
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# JWT token expiry time (e.g., 24h, 7d)
JWT_EXPIRY=24h

# ================== CORS & SECURITY ==================
# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# Rate limiting window (milliseconds)
RATE_LIMIT_WINDOW_MS=900000

# Rate limiting max requests per window
RATE_LIMIT_MAX_REQUESTS=100

# ================== LOGGING ==================
# Log level (trace, debug, info, warn, error)
LOG_LEVEL=info

# Enable audit logging
AUDIT_LOGGING_ENABLED=true

# Audit log retention days
AUDIT_LOG_RETENTION_DAYS=90

# ================== ATTESTATION CONFIG ==================
# Attestation expiry time in hours
ATTESTATION_EXPIRY_HOURS=24

# Nonce minimum value
ATTESTATION_NONCE_MIN=1

# ================== FEATURE FLAGS ==================
# Enable mock AI evaluations (for development)
USE_MOCK_AI_EVALUATION=true

# Enable audit trail logging
ENABLE_AUDIT_LOGS=true

# Enable signature verification
ENABLE_SIGNATURE_VERIFICATION=true

# Enable deterministic checks
ENABLE_DETERMINISTIC_CHECKS=true
